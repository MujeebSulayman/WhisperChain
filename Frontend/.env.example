# Scarf frontend environment.
# Copy this file to .env.local and fill in the values marked REQUIRED.
# Don't leave a variable set to an empty value: delete or comment out the line instead,
# otherwise it overrides the built-in default with "".

# ── Network ────────────────────────────────────────────────────────
# REQUIRED. A Base Sepolia RPC URL, used for reads and by the relayer.
# The public endpoint works for testing; use a provider (Alchemy, Infura, QuickNode) for anything real.
NEXT_PUBLIC_BASE_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY


# ── Contracts (Base Sepolia) ───────────────────────────────────────
# Optional: these are the deployed addresses and also the built-in defaults.
# Change them only if you deploy your own contracts.
NEXT_PUBLIC_SCARF_ADDRESS=0x03825A9458BFE8F66D6464Ba126f94eB4D02AE43
NEXT_PUBLIC_FORWARDER_ADDRESS=0x61d6789168986B18Eb1423894c5147De1B5afCf1
NEXT_PUBLIC_PAYMASTER_ADDRESS=0xA3bFa5c5c950D58A4fa7bB0fD8DBB0464AF65F4f

# ── Relayer (server only) ──────────────────────────────────────────
# REQUIRED to send messages. The private key of the wallet that submits gasless transactions.
# It needs a little Base Sepolia ETH for gas. Never prefix it with NEXT_PUBLIC_ and never commit it.
RELAYER_PRIVATE_KEY=
# Refund the Paymaster pays the relayer per message, in wei (0.00005 ETH).
RELAYER_REIMBURSEMENT_WEI=50000000000000
# Optional: send signed requests to an external relayer instead of the built-in /api/relay.
# NEXT_PUBLIC_RELAYER_API_URL=https://your-relayer.example.com/relay

# ── IPFS (Pinata) ──────────────────────────────────────────────────
# REQUIRED for photos, video and files (text messages work without them).
# These are visible in the browser, so use a Pinata key scoped to pinning only.
NEXT_PUBLIC_PINATA_API_KEY=
NEXT_PUBLIC_PINATA_SECRET_KEY=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
