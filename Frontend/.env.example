# Scarf frontend environment.
# Copy this file to .env.local and fill in the values marked REQUIRED.
# Don't leave a variable set to an empty value: delete or comment out the line instead,
# otherwise it overrides the built-in default with "".

# ── Network ────────────────────────────────────────────────────────
# Which Base network to use: "base-sepolia" (default; where the contracts are deployed today)
# or "base" (mainnet). Switching to "base" also needs the three contract addresses below,
# because Scarf isn't deployed on mainnet yet. USDC switches to the matching network automatically.
NEXT_PUBLIC_NETWORK=base-sepolia
# REQUIRED. An RPC URL for the SAME network as above, used for reads and by the relayer.
# A mainnet URL with NEXT_PUBLIC_NETWORK=base-sepolia makes every contract read fail.
# Public endpoints work for testing; use a provider (Alchemy, Infura, QuickNode) for anything real.
NEXT_PUBLIC_BASE_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY


# ── Auth (Privy) ───────────────────────────────────────────────────
# REQUIRED. Your Privy app ID from https://dashboard.privy.io. Users log in with a wallet,
# email or Google; email/Google users get a Privy embedded wallet.
# In the Privy dashboard, enable the same login methods and add your domains (e.g. localhost:3000).
NEXT_PUBLIC_PRIVY_APP_ID=


# ── Contracts ──────────────────────────────────────────────────────
# On base-sepolia these are optional: they are the deployed addresses and the built-in defaults.
# On base (mainnet) they are REQUIRED: set them to your mainnet deployment.
NEXT_PUBLIC_SCARF_ADDRESS=0x03825A9458BFE8F66D6464Ba126f94eB4D02AE43
NEXT_PUBLIC_FORWARDER_ADDRESS=0x61d6789168986B18Eb1423894c5147De1B5afCf1
NEXT_PUBLIC_PAYMASTER_ADDRESS=0xA3bFa5c5c950D58A4fa7bB0fD8DBB0464AF65F4f

# ── Relayer (server only) ──────────────────────────────────────────
# REQUIRED to send messages. The private key of the wallet that submits gasless transactions.
# It needs a little Base Sepolia ETH for gas. Never prefix it with NEXT_PUBLIC_ and never commit it.
RELAYER_PRIVATE_KEY=
# Refund the Paymaster pays the relayer per message, in wei (0.00005 ETH).
RELAYER_REIMBURSEMENT_WEI=50000000000000
# Optional abuse limits for /api/relay (defaults shown). Counted per server instance.
# RELAYER_MAX_GAS=3000000
# RELAYER_LIMIT_PER_SENDER_MINUTE=10
# RELAYER_LIMIT_PER_SENDER_DAY=300
# RELAYER_LIMIT_PER_IP_MINUTE=30
# Optional: send signed requests to an external relayer instead of the built-in /api/relay.
# NEXT_PUBLIC_RELAYER_API_URL=https://your-relayer.example.com/relay

# ── IPFS (Pinata) ──────────────────────────────────────────────────
# REQUIRED for photos, video and files (text messages work without them).
# These are visible in the browser, so use a Pinata key scoped to pinning only.
NEXT_PUBLIC_PINATA_API_KEY=
NEXT_PUBLIC_PINATA_SECRET_KEY=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
